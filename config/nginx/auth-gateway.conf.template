# Easy Cognito Nginx Gateway Authentication
# Template configuration file - replace variables with your values
#
# Variables to replace:
#   {{DOMAIN}}              - Your domain or IP (e.g., example.com or 52.43.35.1)
#   {{APP1_NAME}}           - Name of first application (e.g., myapp)
#   {{APP1_PORT}}           - Port of first application (e.g., 3000)
#   {{APP1_PATH}}           - URL path for first app (e.g., /app or /)
#   {{SSL_CERT_PATH}}       - Path to SSL certificate
#   {{SSL_KEY_PATH}}        - Path to SSL private key
#   {{OAUTH2_PROXY_PORT}}   - oauth2-proxy port (default: 4180)

upstream oauth2_proxy {
    server 127.0.0.1:{{OAUTH2_PROXY_PORT}};
}

upstream {{APP1_NAME}} {
    server 127.0.0.1:{{APP1_PORT}};
}

# Add more upstreams as needed for additional apps:
# upstream app2 {
#     server 127.0.0.1:4000;
# }

# HTTP Server - Redirect all traffic to HTTPS
# This prevents OAuth state mismatch issues by ensuring all
# authentication flows start over HTTPS
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name {{DOMAIN}};

    # Redirect all HTTP requests to HTTPS
    return 301 https://$host$request_uri;
}

# HTTPS Server - Main application server
server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;

    # SSL Configuration
    ssl_certificate {{SSL_CERT_PATH}};
    ssl_certificate_key {{SSL_KEY_PATH}};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    server_name {{DOMAIN}};

    # OAuth2 Proxy endpoints (public, no auth required)
    # These endpoints handle the authentication flow
    location /oauth2/ {
        proxy_pass http://oauth2_proxy;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Scheme $scheme;
        proxy_set_header X-Auth-Request-Redirect $request_uri;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Cookie handling - ensure cookies are passed through
        proxy_set_header Cookie $http_cookie;
        proxy_pass_request_headers on;

        # Buffer settings for OAuth flow (important for Cognito responses)
        proxy_buffer_size 16k;
        proxy_buffers 8 64k;
        proxy_busy_buffers_size 128k;
        proxy_redirect default;
    }

    # Protected Application Route
    location {{APP1_PATH}} {
        # Authentication check
        # All requests go through oauth2-proxy for validation
        auth_request /oauth2/auth;
        error_page 401 = /oauth2/start?rd=$scheme://$host$request_uri;

        # Pass authentication headers from oauth2-proxy to backend
        auth_request_set $user $upstream_http_x_auth_request_user;
        auth_request_set $email $upstream_http_x_auth_request_email;
        auth_request_set $auth_cookie $upstream_http_set_cookie;
        add_header Set-Cookie $auth_cookie;

        # Rewrite path if needed (uncomment for sub-paths like /app/)
        # rewrite ^{{APP1_PATH}}(.*)$ /$1 break;

        # Proxy to your application
        proxy_pass http://{{APP1_NAME}};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Pass authenticated user info to backend
        # Your app can read these headers to get user information
        proxy_set_header X-User-Email $email;
        proxy_set_header X-Auth-Request-User $user;

        # WebSocket support (if your app needs it)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 86400;
    }

    # Health check endpoint (no auth required)
    # Useful for monitoring and load balancer health checks
    location /health {
        access_log off;
        return 200 "healthy\n";
        add_header Content-Type text/plain;
    }
}
