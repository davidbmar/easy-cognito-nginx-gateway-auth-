# AWS Cognito Configuration
# Copy this file to config.env and fill in your values

# AWS Region for Cognito
export COGNITO_REGION=us-east-1

# Cognito User Pool ID (format: us-east-1_XXXXX)
export COGNITO_POOL_ID=us-east-1_aVHSg58BS

# Cognito App Client ID
export COGNITO_CLIENT_ID=46gdd9glnaetl44e2mtap51bkk

# Cognito App Client Secret
export COGNITO_CLIENT_SECRET=l4trmemvsbj1i21p1pecbhv04g4h5fcvt20nc4gtsgk27s2qpp2

# Cognito Domain (without .auth.{region}.amazoncognito.com suffix)
export COGNITO_DOMAIN=website-cloner-1768163881

# Public IP or domain for this instance
# Leave empty to auto-detect from EC2 metadata
export PUBLIC_IP=

# AWS Security Group ID (for deploy-portal IP whitelisting)
export SECURITY_GROUP_ID=sg-0d6bbadbbd290b320

# AWS Region (for API calls)
export AWS_REGION=us-east-1

# OAuth2 Proxy Port (default: 4180)
export OAUTH2_PORT=4180
